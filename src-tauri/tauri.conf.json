{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tracko",
  "version": "0.1.0",
  "identifier": "app.tracko.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tracko",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#000000",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A personal tracker you talk to",
    "longDescription": "Drop in a one-liner, a paragraph or a screenshot. Claude splits it into tasks, notes and done items, files it in the right bucket, and helps you look back at what you did.",
    "copyright": "Copyright (c) 2026 akhshyganesh. MIT licence.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
